{# file ~/Sites/opac/templates/app/homepage.html.twig #}

{% extends 'app/base.html.twig' %}

{# title override #}
{% block title %}{{ 'homepage.title' | trans }} | {{ parent() }}{% endblock %}

{# description override #}
{% block description %}{{ 'homepage.seo.description' | trans }}{% endblock %}

{# keywords override #}
{% block keywords %}{{ 'homepage.seo.keywords' | trans }}{% endblock %}

{# JSON-LD overrides #}
{% block page_name %}{{ 'homepage.seo.page_name' | trans }}{% endblock %}
{% block page_description %}{{ 'homepage.seo.description' | trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/homepage.css') }}">
{% endblock %}

{% block main %}

    <h1 class="cartouche-header">{{ 'homepage.seo.h1' | trans }}</h1>

    {% include '_flash_messages.html.twig' ignore missing %}

    {# card 0: welcome card (full width) #}
    <div class="pendoncete-card mb-4">
        <h2>Pendoncete's blog app</h2>
        <p>{{ 'homepage.intro' | trans }}</p>
    </div>

    {# 2-column grid for navigation cards #}
    <section class="homepage-grid">

        {# card 1: posts #}
        <div class="pendoncete-card">
            <div>
                <h2>{{ 'homepage.posts.title' | trans }}</h2>
                <p>{{ 'homepage.posts.abstract' | trans }}</p>
            </div>
            <div class="d-flex align-items-center gap-2 mt-3">
                <a
                    href="{{ path('app_posts') }}"
                    title="{{ 'homepage.posts.link_label' | trans }}"
                    class="btn-back-to-top"
                >
                    <i class="fa-solid fa-circle-arrow-right"></i>
                </a>
                <span class="mb-0">{{ 'homepage.posts.link_label' | trans }}</span>
            </div>
        </div>

        {# card 2: categories #}
        <div class="pendoncete-card">
            <div>
                <h2>{{ 'homepage.categories.title' | trans }}</h2>
                <p>{{ 'homepage.categories.abstract' | trans }}</p>
            </div>
            <div class="d-flex align-items-center gap-2 mt-3">
                <a
                    href="{{ path('app_categories') }}"
                    title="{{ 'homepage.categories.link_label' | trans }}"
                    class="btn-back-to-top"
                >
                    <i class="fa-solid fa-circle-arrow-right"></i>
                </a>
                <span class="mb-0">{{ 'homepage.categories.link_label' | trans }}</span>
            </div>
        </div>

    </section>

{% endblock %}

