{# file ~/Sites/blog/templates/posts/post_preview.html.twig #}

{% from "@shared/macros/image_utilities.html.twig" import display_entity_image %}

<div class="preview-card">
    <div class="preview-header">

        <div class="preview-header-icons">
            <div class="preview-image">
                {{ display_entity_image('post', 'small') }}
            </div>

            <div class="rating-small-cartouche">
                <div class="stars-container">
                    <i class="fas fa-star star-review-icon-mini"></i>
                    <i class="fas fa-star star-review-icon-mini"></i>
                    <i class="far fa-star star-review-icon-mini"></i>
                    <i class="far fa-star star-review-icon-mini"></i>
                    <i class="far fa-star star-review-icon-mini"></i>
                </div>
            </div>
        </div>

        <div class="preview-title">
            <a href="{{ path('app_post', { 'slug': slug }) }}">{{ title }}</a>
        </div>

        <div class="preview-metrics">
            {% if language is defined and language %}
                <div class="preview-metrics-tl">
                    {% if language == 'es' %}
                        <span class="fi fi-es" title="español">&nbsp;</span>
                    {% elseif language == 'el' %}
                        <span class="fi fi-gr" title="ἑλληνικά">&nbsp;</span>
                    {% else %}
                        <span class="fi fi-gb" title="english">&nbsp;</span>
                    {% endif %}
                </div>
            {% endif %}

            {% if diffusio is defined and diffusio %}
                <div class="preview-metrics-tq">
                    <i class="{{ diffusio.iconClass }}" title="{{ diffusio.label }}"></i>
                </div>
            {% endif %}

            {% if copulationes is defined and copulationes is not empty %}
                {% for copulatio in copulationes %}
                    {% if copulatio.category is defined and copulatio.category %}
                        <div class="preview-metrics-tq" title="{{ copulatio.category.name }}">
                            <a href="{{ path('app_category', { 'slug': copulatio.category.slug }) }}" style="color: inherit; text-decoration: none; cursor: pointer;">
                                <span class="registrum-icon">{{ copulatio.category.id | slice(0, 2) }}</span>
                            </a>
                        </div>
                    {% endif %}
                {% endfor %}
            {% endif %}

            {% if status is defined and status %}
                <div class="preview-metrics-tq" title="{{ status.label | trans }}">
                    <span class="registrum-icon">{{ status.value }}</span>
                </div>
            {% endif %}
        </div>
    </div>

    <div class="preview-body">
        <b>WHEN</b> {{ date }}

        {% if copulationes is defined and copulationes is not empty %}
            {% set cop_count = copulationes | length %}
            {% set label_key = cop_count > 1 ? 'post.categories' : 'post.category' %}
            <b>{{ label_key | trans | upper }}</b>
            {% for copulatio in copulationes %}
                {% if copulatio.category is defined and copulatio.category %}
                    <a href="{{ path('app_category', { 'slug': copulatio.category.slug }) }}" class="category-link" style="color: inherit; text-decoration: none; cursor: pointer;">{{ copulatio.category.name }}</a>{% if not loop.last %}, {% endif %}
                {% endif %}
            {% endfor %}
        {% endif %}

        <b>WHAT</b> {{ excerpt }}
        <input
            type="button"
            value="see more..."
            onclick="window.location.href='{{ path('app_post', { 'slug': slug }) }}'"
            class="btn-see-more"
            style="display: inline-block; margin-left: 0.25rem;"
        >

        {% if thumbnails is defined and thumbnails is iterable and thumbnails|length > 0 %}
            <div class="preview-thumbnails">
                {% for thumb in thumbnails %}
                    <img src="{{ thumb }}" alt="thumbnail" class="preview-thumb-img" />
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <div class="preview-footer">
        {# future metadata hooks #}
    </div>
</div>
