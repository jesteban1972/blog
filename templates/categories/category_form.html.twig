{# file ~/Sites/blog/templates/categories/category_form.html.twig #}

{% extends 'app/base.html.twig' %}

{% block title %}
    {% if category and category.id %}
        {{ category.name }} - {{ 'categories.seo.page_name'|trans }}
    {% else %}
        {{ 'categories.form.new_title'|trans }} - {{ 'categories.seo.page_name'|trans }}
    {% endif %}
{% endblock %}

{% block main_contents %}
    <div class="container my-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <header class="mb-4">
                    <h1 class="h2">
                        {% if category and category.id %}
                            {{ category.name }}
                        {% else %}
                            {{ 'categories.form.new_title'|trans }}
                        {% endif %}
                    </h1>
                </header>

                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_label(form.name, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.name) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.slug, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.slug, {'attr': {'class': 'form-control'}}) }}
                    <div class="form-text">{{ form_help(form.slug) }}</div>
                    {{ form_errors(form.slug) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.description) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.parent, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.parent, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.parent) }}
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="{{ path('app_categories') }}" class="btn btn-outline-secondary">
                        {{ 'global_labels.cancel'|trans }}
                    </a>
                    <button type="submit" class="btn btn-primary">
                        {% if category and category.id %}
                            {{ 'global_labels.save'|trans }}
                        {% else %}
                            {{ 'global_labels.create'|trans }}
                        {% endif %}
                    </button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
